# Read by docker-compose.yml at the repo root (docker compose loads .env
# automatically). Copy to .env and adjust before running `docker compose up`.

JWT_SECRET=change-me-in-production

# The URL the *browser* will use to reach the backend — set this to your
# machine's LAN IP (e.g. http://192.168.1.50:3000) if you're testing from a
# phone or another device, not "localhost" (which resolves to that device
# itself, not this machine).
API_URL=http://localhost:3000
