# Base URL of the NestJS backend. Defaults to http://localhost:3000 if unset.
VITE_API_URL="http://localhost:3000"

# Google OAuth "Web application" Client ID (from Google Cloud Console ->
# Credentials). Not a secret. Used for both the web Google Identity Services
# button and as the native Android Credential Manager flow's server client
# ID — the backend's GOOGLE_CLIENT_ID must be set to this same value.
# The Google sign-in button is hidden entirely when this is unset.
VITE_GOOGLE_CLIENT_ID=""
