DATABASE_URL="postgresql://alarmlock:alarmlock@localhost:5432/alarmlock?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
PORT=3000

# Google Sign-In. This is the OAuth 2.0 "Web application" Client ID from
# Google Cloud Console (Credentials page) — used as the audience to verify
# ID tokens from both the web (Google Identity Services) and native Android
# (Credential Manager, configured with the same Web Client ID as its
# "server client id") sign-in flows. Not a secret; safe to ship in clients.
GOOGLE_CLIENT_ID=""

# Payments
PAYMENTS_PROVIDER="stripe"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Vision
CLOUD_VISION_API_KEY=""

# Weather
WEATHER_API_KEY=""
